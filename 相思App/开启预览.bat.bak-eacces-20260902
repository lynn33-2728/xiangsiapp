@echo off
chcp 936 >nul 2>&1
REM 本文件必须存成 GBK 编码。cmd 是按系统代码页成块读入 bat 的，
REM 写在第二行的 chcp 对已经读入的内容无效，UTF-8 中文会乱码甚至被当成命令名。
setlocal
set "PORT=5193"
set "URL=http://127.0.0.1:%PORT%/"
cd /d "%~dp0"

REM ============ 自动探测 node.exe：家里/公司/任何电脑通用 ============
set "NODE="

REM 1) WorkBuddy 自带的 node：跟随当前用户名，换电脑也能找到
for /f "delims=" %%V in ('dir /b /o-n "%USERPROFILE%\.workbuddy\binaries\node\versions" 2^>nul') do (
  if not defined NODE if exist "%USERPROFILE%\.workbuddy\binaries\node\versions\%%V\node.exe" set "NODE=%USERPROFILE%\.workbuddy\binaries\node\versions\%%V\node.exe"
)

REM 2) 系统 PATH 里装过的 node
if not defined NODE for /f "delims=" %%P in ('where node 2^>nul') do if not defined NODE set "NODE=%%P"

REM 3) 上次记录的路径（电脑开启预览小工具写下的缓存，读不到就跳过）
if not defined NODE if exist "%~dp0launcher_node.txt" for /f "usebackq delims=" %%P in ("%~dp0launcher_node.txt") do if not defined NODE if exist "%%P" set "NODE=%%P"

REM 4) 常见安装位置
if not defined NODE if exist "%ProgramFiles%\nodejs\node.exe" set "NODE=%ProgramFiles%\nodejs\node.exe"
if not defined NODE if exist "%ProgramFiles(x86)%\nodejs\node.exe" set "NODE=%ProgramFiles(x86)%\nodejs\node.exe"
if not defined NODE if exist "%LOCALAPPDATA%\Programs\nodejs\node.exe" set "NODE=%LOCALAPPDATA%\Programs\nodejs\node.exe"

REM 5) 项目自带的便携 node（本目录或上一级目录，跟着项目走）
if not defined NODE if exist "%~dp0node.exe" set "NODE=%~dp0node.exe"
if not defined NODE if exist "%~dp0..\node.exe" set "NODE=%~dp0..\node.exe"

if not defined NODE goto :nonode

echo [相思App] 使用 node: %NODE%

REM ============ 端口已在监听就直接开浏览器 ============
call :portopen
if %errorlevel%==0 goto :open

echo [相思App] 正在启动预览服务（端口 %PORT%）...
start "相思App预览服务" /min "%NODE%" serve.js

REM ============ 等服务起来，最多约 20 秒 ============
set /a "tries=0"
:wait
call :portopen
if %errorlevel%==0 goto :open
set /a "tries+=1"
if %tries% geq 20 goto :fail
timeout /t 1 >nul 2>&1 || ping -n 2 127.0.0.1 >nul 2>&1
goto :wait

:open
start "" "%URL%"
exit /b 0

:fail
echo.
echo [相思App] 启动超时，20 次探测都没连上 %URL%
echo 请在本文件夹打开命令行，手动运行下面这行看报错：
echo   "%NODE%" serve.js
echo.
pause
exit /b 1

:nonode
echo.
echo [相思App] 这台电脑上找不到 node.exe，已找过这些地方：
echo   1. %%USERPROFILE%%\.workbuddy\binaries\node\versions\*\node.exe
echo   2. 系统 PATH 里的 node
echo   3. launcher_node.txt 里记的路径
echo   4. Program Files / LocalAppData 下的 nodejs
echo   5. 本目录和上一级目录的 node.exe
echo.
echo 解决办法，任选一个：
echo   A. 装个 Node.js：https://nodejs.org  （装完重新双击本文件）
echo   B. 把 node.exe 复制一份到本文件夹，和这个 bat 放一起
echo.
pause
exit /b 1

REM ============ 子程序：探测端口是否通（0=通，1=不通）============
:portopen
"%NODE%" -e "const n=require('net');const s=n.connect(%PORT%,'127.0.0.1',()=>{s.destroy();process.exit(0)});s.on('error',()=>process.exit(1));setTimeout(()=>process.exit(1),2000)" >nul 2>&1
exit /b %errorlevel%
